<mujoco model="meat_cell">
  <!--
    The cell around the arm: a belt that carries a slab past a UR5e, and a cutter
    lane to place it in. The arm and gripper are attached at build time by
    scene.py, so the pinned Menagerie files stay untouched.

    Frames follow REP 103: x forward along the belt travel direction, z up.
    Belt top surface is at z = 0.90 m, the working height used in the cell
    layout in library/topics/meat-cutting-automation.md.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" noslip_iterations="3"/>

  <!-- Offscreen buffer must be declared here; the default 640x480 caps Renderer size. -->
  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <default class="cell_visual">
      <geom group="2" contype="0" conaffinity="0" density="0"/>
    </default>
    <!-- Geoms that both render and collide. Group 3 is hidden by the renderer,
         which is why these must stay in the default group. -->
    <default class="cell_solid">
      <geom group="0" condim="4" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.22 0.24 0.26" rgb2="0.26 0.28 0.30"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
    <material name="belt_mat" rgba="0.88 0.89 0.90 1"/>
    <material name="steel" rgba="0.72 0.74 0.76 1"/>
    <material name="slab_mat" rgba="0.87 0.71 0.68 1"/>
    <material name="lane_mat" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.4 0.2 2.4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light name="fill" pos="-0.8 1.2 2.0" dir="0.3 -0.5 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="4 4 0.05" material="grid" class="cell_solid"/>

    <!-- Arm pedestal. The UR5e base attaches at arm_mount. -->
    <body name="pedestal" pos="0 0 0">
      <geom name="pedestal_col" type="cylinder" size="0.09 0.45" pos="0 0 0.45"
            material="steel" class="cell_solid"/>
      <site name="arm_mount" pos="0 0 0.90" quat="1 0 0 0"/>
    </body>

    <!--
      Belt. A long slab on a slide joint driven at constant velocity; the product
      is carried by friction rather than teleported, so slip is emergent and the
      tracking chain sees the same error a real belt produces. Two metres of
      travel is far longer than one episode needs.
    -->
    <body name="belt" pos="0 0.50 0.87">
      <!--
        Damping must stay at zero. A velocity servo settles where kv*(ctrl - v)
        balances the damping force c*v, so v = ctrl*kv/(kv+c): with c=200 and
        kv=400 the belt ran at two thirds of the commanded speed, which would
        have silently biased every intercept. With c=0 the servo alone sets the
        speed and the only error is the load term, under 1 mm/s here.
      -->
      <joint name="belt_x" type="slide" axis="1 0 0" range="-3 3" damping="0" armature="1"/>
      <geom name="belt_surface" type="box" size="1.6 0.35 0.03" material="belt_mat"
            friction="0.55 0.02 0.001" class="cell_solid" mass="40"/>
      <site name="belt_origin" pos="0 0 0.03" size="0.004" rgba="0.9 0.6 0.2 0.6"/>
    </body>

    <!--
      One rail, on the far side only. The customer's belt is open on the near
      side on purpose: operators orient each leg so its trotter hangs off that
      edge, and a rail there would stop the very thing the station exists to do.

      The rail that remains must clear the belt in y. An earlier one overlapped
      the belt edge and touched it at z = 0.90, which jammed the moving belt
      against the static world and held it at zero speed under full actuator
      force.
    -->
    <geom name="rail_far" type="box" pos="0 0.865 0.945" size="1.6 0.008 0.045"
          material="steel" class="cell_solid"/>

    <!--
      Product. Rigid box is the control arm of the experiment: it isolates
      tracking and controller error from deformation error. The flex slab
      replaces this body in the deformable conditions.
    -->
    <body name="slab" pos="-0.60 0.50 0.945">
      <freejoint name="slab_free"/>
      <geom name="slab_geom" type="box" size="0.090 0.045 0.015" material="slab_mat"
            mass="0.5" friction="0.35 0.01 0.001" class="cell_solid"/>
      <site name="slab_centre" size="0.004" rgba="0.2 0.9 0.4 0.8"/>
    </body>

    <!--
      Cutter lane. The datum edge is the reference the placement error is measured
      against: lane offset is the y distance from slab centre to lane centreline,
      yaw is the angle between the slab long axis and the lane axis.
    -->
    <body name="cutter_lane" pos="0.30 -0.45 0.90">
      <geom name="lane_floor" type="box" size="0.16 0.10 0.010" pos="0 0 0.010"
            material="lane_mat" class="cell_solid"/>
      <geom name="lane_datum" type="box" size="0.16 0.008 0.030" pos="0 -0.108 0.030"
            material="steel" class="cell_solid"/>
      <site name="lane_centre" pos="0 0 0.020" size="0.005" rgba="0.2 0.6 0.9 0.8"/>
    </body>

    <!--
      Cameras. Overhead sits 800 mm above the belt and 400 mm upstream of the
      pick zone; verification is 500 mm above the lane. The upstream distance
      buys 500 ms of belt travel at 300 mm/s between exposure and pick.

      The overhead camera was at 600 mm above the belt, giving a 741 by 556 mm
      field. A whole pork leg is 722 mm long, so it touched the frame border at
      almost any angle and the border guard refused it.

      The binding constraint is the field's SHORT axis, because a leg can lie
      across the belt as easily as along it. Covering the 700 mm belt width puts
      the camera 950 mm above the belt, for a 981 by 735 mm field.

      The cost is resolution, and it is not recoverable by moving the camera:
      ground sampling is field width divided by pixel count, so 981 mm across
      1280 pixels is 0.77 mm per pixel whatever the lens. It was 0.58 mm. Buying
      it back needs about 1700 pixels across, which is a 4 megapixel sensor
      rather than this 1.2 megapixel one.

      A MuJoCo camera looks along its own -z with +y up, so identity already
      points straight down. quat="0 1 0 0" flips it to face the ceiling.
    -->
    <body name="overhead_cam_mount" pos="-0.40 0.50 1.85">
      <geom name="cam_body" type="box" size="0.03 0.03 0.02" material="steel" class="cell_visual"/>
      <camera name="overhead" pos="0 0 0" quat="1 0 0 0" fovy="52"/>
    </body>

    <!--
      Verification camera over the lane. The control architecture analysis found
      that in-hand shift at gripper closure exceeds the placement bound on its
      own, so no belt-side loop can meet it; this camera is what closes the
      fixture-side loop that can. It is required, not optional.
    -->
    <body name="verify_cam_mount" pos="0.30 -0.45 1.40">
      <geom name="verify_cam_body" type="box" size="0.03 0.03 0.02" material="steel" class="cell_visual"/>
      <camera name="verify" pos="0 0 0" quat="1 0 0 0" fovy="52"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="belt_drive" joint="belt_x" kv="2000" ctrlrange="-1.0 1.0"/>
  </actuator>

  <sensor>
    <jointpos name="belt_encoder" joint="belt_x"/>
    <jointvel name="belt_speed" joint="belt_x"/>
    <framepos name="slab_pos" objtype="site" objname="slab_centre"/>
    <framequat name="slab_quat" objtype="body" objname="slab"/>
    <framepos name="lane_pos" objtype="site" objname="lane_centre"/>
  </sensor>
</mujoco>
