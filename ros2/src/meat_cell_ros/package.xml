<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypenamespace="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meat_cell_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the pork leg cell's grasp pipeline: belt state from the encoder, a swappable grasp policy, and an arm-agnostic executor that uses MoveIt IK and a ros2_control trajectory controller. The cell logic is the numpy-only part of the lab repo's src: robotics.core and applications.pork_leg_alignment.grasping.</description>
  <maintainer email="jainlakshya04@gmail.com">Lakshya Jain</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>meat_cell_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
